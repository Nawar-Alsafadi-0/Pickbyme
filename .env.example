DATABASE_URL=sqlite:///./pickbyme.db
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_MINUTES=10080

# Optional bootstrap administrator. Set both in production before first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Thawani hosted checkout. Leave keys empty to keep manual confirmation mode.
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_API_BASE=https://uatcheckout.thawani.om/api/v1
THAWANI_CHECKOUT_BASE=https://uatcheckout.thawani.om/pay
